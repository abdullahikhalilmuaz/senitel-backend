# Add these variables to your existing backend/.env. Do not overwrite MONGO_URI,
# JWT_SECRET, or other existing secrets.
# SMTP is used for real high-risk email OTP delivery when all SMTP fields are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Local defence/demo fallback only. When enabled in NODE_ENV=development, the
# code is displayed in the app because no email provider is configured.
# MUST remain false in production.
DEMO_OTP_ENABLED=true
